<article class="col-sm-6 col-md-4 col-xl-3 magasin" itemscope itemtype="https://schema.org/LocalBusiness">

    <picture>

{*        <source srcset="/" type="image/webp">*}
        <img src="/themes/classic/assets/img/magasins/magasin.png" loading="lazy"
             width="362"
             height="167"
             alt="Districlos Bourgogne"
             itemprop="image"/>
    </picture>

    <div class="details">
        <div class="block block-title">
            <span class="small-title" itemprop="name">Districlos</span>
            <span class="departement">Bourgogne</span>
        </div>

        <address class="block block-adresse" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
            <span class="adresse" itemprop="streetAddress">Zac du Champ Chassy</span>
            <span class="adresse">
                    <span class="cp" itemprop="postalCode">71380</span>
                    <span class="ville" itemprop="addressLocality">Chatenoy en Bresse</span>
                    <meta itemprop="addressCountry" content="FR"/>
                </span>
        </address>

        <div class="block block-contact">
            <span class="email">
                <a href="mailto:bourgogne@districlos.com" itemprop="email">
                    <picture><source srcset="/themes/classic/assets/img/magasins/email.webp" type="image/webp"><img src="/themes/classic/assets/img/magasins/email.png" alt="email" width="14" height="10"></picture>
                    bourgogne@districlos.com
                </a>
            </span>
            <span class="telephone">
                <a href="tel:+33385482568" itemprop="telephone">
                    <picture><source srcset="/themes/classic/assets/img/magasins/telephone.webp" type="image/webp"><img src="/themes/classic/assets/img/magasins/telephone.png" alt="telephone" width="14" height="12"></picture>
                    03 85 48 25 68
                </a>
            </span>
        </div>

        <div class="block block-horaire">
            <span class="jours">{l s='Lundi - Vendredi' d='Shop.Theme.Customstores'}</span>
            <span class="heures" itemprop="openingHours">07:30-12:00, 13:30-17:30</span>
        </div>

        <div class="block block-actions">
            <a href="#" class="favoris">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </a>

            <a href="#" class="btn btn-primary btn-primary-small" itemprop="url">{l s='Voir la page du magasin' d='Shop.Theme.Customstores'}</a>
        </div>
    </div>
</article>
