<div id="customfilterselector">
    <div class="customfilterselector-question">Quel type de clôture recherchez-vous ?</div>
    <div class="customfilterselector-options-container">
        <div class="customfilterselector-option-container">
            <img src="https://liana.cloture-discount.fr/img/custom_filtres_465.png" alt="option Clôture rigide">
            <div class="customfilterselector-option-text">Clôture rigide</div>
        </div>
        <div class="customfilterselector-option-container">
            <img src="https://liana.cloture-discount.fr/img/custom_filtres_465.png" alt="option Clôture souple">
            <div class="customfilterselector-option-text">Clôture souple</div>
        </div>
        <div class="customfilterselector-option-container">
            <img src="https://liana.cloture-discount.fr/img/custom_filtres_lapin.png" alt="option Clôture pour animaux">
            <div class="customfilterselector-option-text">Clôture pour animaux</div>
        </div>
    </div>
    <div class="customfilterselector-validate-container">
        <div></div>
        <button id="customfilterselector-validate-option-first" class="customfilterselector-validate-option" disabled="disabled">
            Valider
        </button>
        <div id="customfilterselector-skip-option" class="customfilterselector-skip-option">
            Passer
        </div>
    </div>
</div>

<div id="customfilterselector" class="customfilterselector-hauteur">
    <div class="customfilterselector-question">Quelle hauteur de clôture recherchez-vous ?</div>
    <div class="customfilterselector-options-container">
    </div>
    <div class="customfilterselector-validate-container">
        <div id="customfilterselector-back-option" class="customfilterselector-skip-option">
            Retour
        </div>
        <button id="customfilterselector-validate-option-all" class="customfilterselector-validate-option">
            Valider
        </button>
        <div></div>
    </div>
</div>