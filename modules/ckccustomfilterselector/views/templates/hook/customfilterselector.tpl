<div id="customfilterselector">
    <div class="customfilterselector-question">{l s='Quel type de clôture recherchez-vous ?' d='Shop.Theme.Customckc'}</div>
    <div class="customfilterselector-options-container">
        <div class="customfilterselector-option-container">
            <img src="/modules/ckccustomfilterselector/views/img/custom_filtres_465.png" alt="{l s='option Clôture rigide' d='Shop.Theme.Customckc'}">
            <div class="customfilterselector-option-text">{l s='Clôture rigide' d='Shop.Theme.Customckc'}</div>
        </div>
        <div class="customfilterselector-option-container">
            <img src="/modules/ckccustomfilterselector/views/img/custom_filtres_465.png" alt="{l s='option Clôture souple' d='Shop.Theme.Customckc'}">
            <div class="customfilterselector-option-text">{l s='Clôture souple' d='Shop.Theme.Customckc'}</div>
        </div>
        <div class="customfilterselector-option-container">
            <img src="/modules/ckccustomfilterselector/views/img/custom_filtres_lapin.png" alt="{l s='option Clôture pour animaux' d='Shop.Theme.Customckc'}">
            <div class="customfilterselector-option-text">{l s='Clôture pour animaux' d='Shop.Theme.Customckc'}</div>
        </div>
    </div>
    <div class="customfilterselector-validate-container">
        <div></div>
        <button id="customfilterselector-validate-option-first" class="customfilterselector-validate-option" disabled="disabled">
            {l s='Valider' d='Shop.Theme.Customckc'}
        </button>
        <div id="customfilterselector-skip-option" class="customfilterselector-skip-option">
            {l s='Passer' d='Shop.Theme.Customckc'}
        </div>
    </div>
</div>

<div id="customfilterselector" class="customfilterselector-hauteur">
    <div class="customfilterselector-question">{l s='Quelle hauteur de clôture recherchez-vous ?' d='Shop.Theme.Customckc'}</div>
    <div class="customfilterselector-options-container">
    </div>
    <div class="customfilterselector-validate-container">
        <div id="customfilterselector-back-option" class="customfilterselector-skip-option">
            {l s='Retour' d='Shop.Theme.Customckc'}
        </div>
        <button id="customfilterselector-validate-option-all" class="customfilterselector-validate-option">
            {l s='Valider' d='Shop.Theme.Customckc'}
        </button>
        <div></div>
    </div>
</div>